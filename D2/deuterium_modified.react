! ===== 电子碰撞反应 (Electron impact reactions) =====
! ISOTOPE POLICY: electron tables use electron energy without mass scaling; known D2 thresholds are retained.
! Heavy-particle tables are H/H2 proxies tabulated versus projectile laboratory energy; no hidden sigma multiplier.

! Reaction 1: 电子-D2 弹性碰撞 (Elastic collision)
e- + D2 --> e- + D2
lxcat 0.0 ELASTIC.txt

! Reaction 2: 电子-D2 振动激发 (Vibrational excitation)
e- + D2 --> e- + D2
lxcat 0.516 EXCITATION2.txt

! Reaction 3: 电子-D2 电离 (Ionization)
e- + D2 --> e- + e- + D2+
lxcat 15.47 IONIZATION.txt

! Reaction 4: 电子-D2 解离电离 (Dissociative ionization)
e- + D2 --> e- + e- + D+ + D
lxcat 19.08 dissociativ.txt

! Reaction 5: 电子-D2 解离激发 (Dissociative excitation)
e- + D2 --> e- + D + D
lxcat 19.08 dissociative_EXCITATION.txt

! ===== D+ 碰撞反应 (D+ impact reactions) =====

! Reaction 6: D+-D2 电荷交换 (Charge exchange)
D+ + D2 -CEX-> D + D2+
lxcat 2.552908e+00 H2-06-IONIZATION.txt

! Reaction 7: D+-D2 激发 [自动识别产生 Dα]
D+ + D2 --> D+ + D2
lxcat 3.000000e+01 H2-08-EXCITATION.txt

! Reaction 8: D+-D2 弹性碰撞
D+ + D2 --> D+ + D2
lxcat 0.000000e+00 H2-10-ELASTIC.txt

! ===== D2+ 碰撞反应 (D2+ impact reactions) =====

! Reaction 9: D2+-D2 生成 D3+
D2+ + D2 --> D3+ + D
lxcat 0.000000e+00 H2-11-IONIZATION.txt

! Reaction 10: D2+-D2 弹性碰撞/动量转移
D2+ + D2 --> D2+ + D2
lxcat 0.000000e+00 H2plus-H2-MOMENTUM_TRANSFER.txt

! Reaction 11: D2+-D2 电荷交换
D2+ + D2 -CEX-> D2 + D2+
lxcat 0.000000e+00 H2-12-IONIZATION.txt

! Reaction 12: D2+-D2 解离电离
D2+ + D2 --> D+ + D + D2
lxcat 5.000000e+00 H2-14-IONIZATION.txt

! Reaction 13: D2+-D2 激发+解离 [自动识别产生 Dα]
D2+ + D2 --> D2+ + D2
lxcat 4.000000e+02 H2-16-EXCITATION.txt

! Reaction 14: D2+-D2 二次电离
D2+ + D2 --> D2+ + D2+ + e-
lxcat 30.0   H2-17-IONIZATION.txt

! ===== D3+ 碰撞反应 (D3+ impact reactions) =====

! Reaction 15: D3+-D2 解离
D3+ + D2 --> D+ + D2 + D2
lxcat 1.100000e+01 H2-18-IONIZATION.txt

! Reaction 16: D3+-D2 解离生成 D
D3+ + D2 --> D2+ + D + D2
lxcat 1.550000e+01 H2-19-IONIZATION.txt

! Reaction 17: D3+-D2 电荷交换
D3+ + D2 --> D2 + D + D2+
lxcat 0.000000e+00 H2-21-IONIZATION.txt

! Reaction 18: D3+-D2 激发+解离 [自动识别产生 Dα]
D3+ + D2 --> D3+ + D2
lxcat 6.200000e+01 H2-23-EXCITATION.txt

! Reaction 19: D3+-D2 弹性碰撞
D3+ + D2 --> D3+ + D2
lxcat 0.000000e+00 H2-25-ELASTIC.txt

! ===== D 碰撞反应 (D atom impact reactions) =====

! Reaction 20: D-D2 缔合电离
D + D2 --> D + D2+ + e-
lxcat 2.034433e+01 H2-30-IONIZATION.txt

! Reaction 21: D-D2 电离
D + D2 --> D+ + D2 + e-
lxcat 2.003314e+01 H2-31-IONIZATION.txt

! Reaction 22: D-D2 激发 [自动识别产生 Dα]
D + D2 --> D + D2
lxcat 2.300000e+01 H2-33-EXCITATION.txt

! Reaction 23: D-D2 弹性碰撞
D + D2 --> D + D2
lxcat 0.000000e+00 H2-36-ELASTIC.txt

! ===== D2 碰撞反应 (D2 fast/excited impact reactions) =====

! Reaction 24: D2-D2 电离
D2 + D2 --> e- + D2+ + D2
lxcat 3.200000e+01 H2-38-IONIZATION.txt

! Reaction 25: D2-D2 解离电离
D2 + D2 --> e- + D+ + D + D2
lxcat 2.090083e+01 H2-43-IONIZATION.txt

! Reaction 26: D2-D2 激发 [自动识别产生 Dα]
D2 + D2 --> D2 + D2
lxcat 1.173625e+01 H2-44-EXCITATION.txt

! Reaction 27: D2-D2 弹性碰撞
D2 + D2 --> D2 + D2
lxcat 0.000000e+00 H2-46-ELASTIC.txt

! ===== D-D 核聚变普通反应 (D-D Fusion Product Reactions) =====
! Bosch & Hale total cross section, split 50/50 into the two product branches.
! MONTE-CARLO BIAS: summed branch cross section and event probability are multiplied by 1e8.
! Divide cumulative branch counts and reaction rates by 1e8 for a physical estimate.
! He3+ is used for charged projectiles; He3 is used for neutral projectiles to conserve charge.
! The remaining deuteron(s) are retained as a spectator D or D2 product.

! Reaction 28: D+ + D2 -> He3 + n branch
D+ + D2 --> He3+ + n + D
lxcat_fusion 2.000000e+03 3.268900e+06 D_fusion_n.txt

! Reaction 29: D+ + D2 -> T + p branch
D+ + D2 --> T + p+ + D
lxcat_fusion 2.000000e+03 4.032700e+06 D_fusion_p.txt

! Reaction 30: D + D2 -> He3 + n branch
D + D2 --> He3 + n + D
lxcat_fusion 2.000000e+03 3.268900e+06 D_fusion_n.txt

! Reaction 31: D + D2 -> T + H branch (neutralized proton product)
D + D2 --> T + H + D
lxcat_fusion 2.000000e+03 4.032700e+06 D_fusion_p.txt

! Reaction 32: D2+ + D2 -> He3 + n branch
D2+ + D2 --> He3+ + n + D2
lxcat_fusion 4.000000e+03 3.268900e+06 D2_fusion_n.txt

! Reaction 33: D2+ + D2 -> T + p branch
D2+ + D2 --> T + p+ + D2
lxcat_fusion 4.000000e+03 4.032700e+06 D2_fusion_p.txt

! Reaction 34: D2 + D2 -> He3 + n branch
D2 + D2 --> He3 + n + D2
lxcat_fusion 4.000000e+03 3.268900e+06 D2_fusion_n.txt

! Reaction 35: D2 + D2 -> T + H branch (neutralized proton product)
D2 + D2 --> T + H + D2
lxcat_fusion 4.000000e+03 4.032700e+06 D2_fusion_p.txt
