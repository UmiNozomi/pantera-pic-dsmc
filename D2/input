!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
!!!!                 Input file for PANTERA                                !!!!
!!!!                                                                       !!!!
!!!! The program reads is line by line, and when it finds a known line, it !!!!
!!!! reads and saves the value in the next one.                            !!!!
!!!! All other lines are ignored (you can comment etc).                    !!!!
!!!! You can put trailing comments on lines, starting with "!" symbol:     !!!!
!!!! the program will remove them before checking the content of a line.   !!!!
!!!!                                                                       !!!!
!!!! All units are SI [m, kg, s, ...]                                      !!!!
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

!Restart:
!    100

Log_level: 5    ! 范围 0–5，数字越大越详细
! ========= Computational domain and grid ===========
Dimensions:
    2
Axisymmetric:
    .TRUE.
Number_of_cells:
    1    1    1
Domain_limits:
    0.0    0.18    0.0    0.09    0.0    6.283185307179586
Domain_periodicity:
    .FALSE.   .FALSE.   .FALSE.
Domain_specular:
    .TRUE.    .FALSE.    .TRUE.    .FALSE.
Domain_diffuse:
    .FALSE.    .FALSE.    .FALSE.   .FALSE.
Boundary_temperature:
    300.0
PIC_type:
   explicit
Jacobian_type:
     3
Mesh_file_SU2:
    'iecq'
Bool_dump_moments:
    .FALSE.
Bool_dump_fluxes:
    .FALSE.
    

Flowfield_output:
    './results/'
Particle_dump_output:
    './results/'
Fluxes_dump_output:
    './results/'
All_output_path:
    './results/'

! ========= Numerical parameters ====================

Fnum:
  1e4
Timestep:
    1.0e-11
Number_of_timesteps:
    1000000
Stats_every:
    100
RNG_seed:
    512875
Binary_output:
    .TRUE.
Dump_grid_start:
    0
Dump_grid_avgevery:
    20
Dump_grid_numavgs:
    250

Dump_part_start:
    500000
Dump_part_every:
   500000
Dump_part_fracsample:
   1.0
Dump_traj_start:
    950000
Dump_traj_every:
   100
Dump_traj_number_per_proc:
   2
Dump_bound_start:
   950000
Dump_bound_avgevery:
   50
Dump_bound_numavgs:
   100
Wall_energy_bins:
   128
Wall_energy_min_eV:
   1.0e-2
Wall_energy_max_eV:
   1.0e6

Perform_checks:
    .TRUE.
Checks_every:
    100

! ============= 光谱诊断设置 (Spectral Diagnostics) =============
Bool_spectral_diagnostics:
    .TRUE.

Spectral_sampling_rate:
    1.0
N_spectral_bins: ! 光谱分辨率（波长点数）Resolution: 200=低, 500=中, 1000=高
    1000          ! 推荐: 500-1000 for higher resolution

Spectral_LOS_direction: ! 观测方向 (X, Y, Z)，会自动归一化
    1.0 0.0 0.0         ! Z轴(默认)。其他例子: X轴=(1,0,0), Y轴=(0,1,0), 对角线=(1,1,1)

! ============= 被动 Hα 诊断 (Passive Hα Diagnostic) =============
! 启用后会输出 results/ha_events.csv，记录碰撞前弹丸速度
! 后处理: python iech2/process_ha_events.py results/ha_events.csv
Bool_ha_passive_diagnostic:
    .FALSE.

Bool_reaction_statistics:
    .FALSE.
! ========= Multispecies ==============================

Species_file:
    D2.species
Def_mixture:
    D2gas D2 1.0
Def_mixture:
    Electrons e- 1.0
Def_mixture:
    Plasma D2+ 0.5 e- 0.5
Def_mixture:
    Ions D2+ 1.0 
! ========= Collisions ==============================

Collision_type: ! [MCC / DSMC / BGK / NONE]
 VAHEDI_MCC

! DSMC VHS collisions

MCC_background_dens:
    1.8E20
MCC_background_Ttra:
    300
MCC_background_mixture:
   D2gas
Thermal_bath_bool:
    .FALSE.
Thermal_bath_Ttr:
    10000.0


! ========= Reactions ==============================
Reactions_file:
    deuterium_modified.react

Wall_reactions_file:
    D2.wall

! ========= Secondary Electron Emission (SEE) =======
SEE_enabled:
     .TRUE.
SEE_materials_file:
    see_materials.dat
SEE_boundary_mapping:
    anode -1 6 T
SEE_boundary_mapping:
    cathode -1 6 T
SEE_boundary_mapping:
    wall -1 10 T
! ========= Initial particle seed ===================
!Boundary_emit:
    !cathode  Electrons   1.0e15   1.0    1.0    1.0    11600.0    0.0    0.0    0.    0.
Initial_particles:
    Electrons   5.0e12   1.0    1.0    1.0    11600.0    0.0    0.0    0.    0.
!Initial_particles:
    !Ions   1.0e11   1.0    1.0    1.0    300.0    0.0    0.0    0.    0.
Remove_particles_by_energy:
    1
    D2  11.0
Boundary_condition:
    axis    neumann 0.0
Boundary_condition:
    axis    specular
! ========= 阳极边界条件 - 增加电流监测 =============
Boundary_condition:
    anode    dirichlet   0.00
Boundary_condition:
    anode    energy_cll 300.00 0.20 0.60 11.0
Boundary_condition:
    anode     react  anode.wall

! ========= 壁面边界条件 - 增加电流监测 =============
Boundary_condition:
    wall     dielectric
Boundary_condition:
    wall    energy_cll 300.00 0.20 0.60 11.0
Boundary_condition:
    wall     react  wall.wall
! ========= 阴极边界条件 - 定电流控制 =============
Boundary_condition:
    cathode    energy_cll 300.00 0.20 0.60 11.0
Boundary_condition:
    cathode constant_current 0.01 -80000.0 5e7 0 0 1000 -900000 -5000
Boundary_condition:
    cathode    react  cathode.wall
    
! ========= MPI parallelization =====================
! == Style for MPI domain partition can be:
! ==
! == 0: longitudinal strips (along x)
! == 1: blocks (equally sized)
!
! For "blocks" style, provide "Domain_partition_num_blocks", giving
! the number of blocks along x and y.
! We expect the number of processes to be N_BLOCKS_X*N_BLOCKS_Y

Partition_style:
    'stripsx'

Load_balance:
    .FALSE.

! ========= 电流监测说明 ==============================
! 
! 新增功能：完整的电流监测和二次电子发射检测
!
! 1. current_monitor 边界条件：
!    - 语法: boundary_name current_monitor [averaging_time]
!    - 功能: 只监测电流，不控制电压
!    - averaging_time: 电流平均时间常数 [s]，可选，默认10.0e-9
!
! 2. 完整电流检测：
!    - 阴极: constant_current (控制电流)
!    - 阳极: current_monitor (监测电流) 
!    - 壁面: current_monitor (监测电流)
!
! 3. 二次电子发射处理：
!    - 自动检测所有边界的二次电子电流贡献
!    - 从阴极发射到阳极的二次电子会被阳极监测
!    - 从壁面发射的二次电子会被相应边界监测
!
! 4. 电流守恒验证：
!    - 输出文件将包含所有边界的电流数据
!    - current_sum_check = I_cathode + I_anode + I_wall
!    - 理论上应接近0（电流守恒）
!
! 5. 输出数据列：
!    - cathode_voltage, cathode_current_total, cathode_current_electron, cathode_current_ion
!    - anode_current_total, anode_current_electron, anode_current_ion  
!    - wall_current_total, wall_current_electron, wall_current_ion
!    - current_sum_check (电流守恒验证)
!
